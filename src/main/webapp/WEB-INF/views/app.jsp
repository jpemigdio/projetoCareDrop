<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="pt-BR"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Care Drop</title><link rel="icon" type="image/jpeg" href="${pageContext.request.contextPath}/assets/logo.jpg">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css?v=agenda-alert-card-20261115">
</head><body><div class="topbar"><span class="brand-mini">CD</span><strong>Care Drop</strong><span class="top-title">Sistema de gestão de medicamentos</span><div class="top-user"><c:out value="${nomeUsuario}"/> · <c:choose><c:when test="${perfilUsuario eq 'ADMIN'}">Administrador</c:when><c:otherwise>Cuidador</c:otherwise></c:choose><form method="post" action="${pageContext.request.contextPath}/auth" class="logout-form"><input type="hidden" name="acao" value="sair"><button>Encerrar sessão</button></form></div></div>
<aside class="sidebar"><div class="brand"><span class="brand-mark">CD</span><div><b>Care Drop</b><small>Casa de Repouso</small></div></div><nav><c:if test="true"><a class="${view == 'dashboard' ? 'active' : ''}" href="${pageContext.request.contextPath}/app?view=dashboard"><i>▦</i>Dashboard</a></c:if><a class="${view == 'agenda' ? 'active' : ''}" href="${pageContext.request.contextPath}/app?view=agenda"><i>◷</i>Agenda de medicamentos</a><div class="nav-label">CUIDADO</div><a class="${view == 'idosos' || view == 'perfil' ? 'active' : ''}" href="${pageContext.request.contextPath}/app?view=idosos"><i>♙</i>Residentes</a><c:if test="true"><div class="nav-label">ADMINISTRAÇÃO</div><a class="${view == 'prescricoes' ? 'active' : ''}" href="${pageContext.request.contextPath}/app?view=prescricoes"><i>✚</i>Prescrições</a><c:if test="${perfilUsuario eq 'ADMIN'}"><a class="${view == 'usuarios' ? 'active' : ''}" href="${pageContext.request.contextPath}/app?view=usuarios"><i>♧</i>Usuários</a></c:if><a class="${view == 'medicamentos' ? 'active' : ''}" href="${pageContext.request.contextPath}/app?view=medicamentos"><i>＋</i>Medicamentos</a><a class="${view == 'administracoes' ? 'active' : ''}" href="${pageContext.request.contextPath}/app?view=administracoes"><i>◷</i>Histórico de doses</a></c:if></nav><div class="sidebar-bottom"><div class="avatar">CD</div><div><b><c:out value="${nomeUsuario}"/></b><small><c:choose><c:when test="${perfilUsuario eq 'ADMIN'}">Administrador</c:when><c:otherwise>Cuidador</c:otherwise></c:choose></small></div></div></aside>
<main class="main"><div class="content"><c:if test="${not empty erro}"><div class="notice error">⚠ &nbsp;<c:out value="${erro}"/></div></c:if><c:if test="${not empty sucesso}"><div class="notice success">✓ &nbsp;<c:out value="${sucesso}"/></div></c:if>
<c:choose>
<c:when test="${view == 'dashboard'}"><header class="page-head"><div><h1>Visão Geral</h1><p>Residentes, medicamentos e doses administradas</p></div><span class="today">Painel integrado</span></header>
<div class="stats"><article class="stat"><span>RESIDENTES</span><b>${idososTotal}</b><em>♙</em></article><article class="stat"><span>MEDICAMENTOS</span><b>${medicamentosTotal}</b><em>✚</em></article></div>
<div class="two-col"><section class="panel"><div class="section-title"><h2>Doses administradas</h2><a href="${pageContext.request.contextPath}/app?view=administracoes">Ver histórico →</a></div><c:choose><c:when test="${empty administracoes}"><p class="empty">Ainda não há administrações registradas.</p></c:when><c:otherwise><div class="table-wrap"><table><thead><tr><th>RESIDENTE</th><th>MEDICAMENTO</th><th>RESPONSÁVEL</th></tr></thead><tbody><c:forEach items="${administracoes}" var="a"><tr><td><c:out value="${a.idoso}"/></td><td><c:out value="${a.medicamento}"/> <small><c:out value="${a.dosagem}"/></small></td><td><c:out value="${a.responsavel}"/></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></section></div>
</c:when>
<c:when test="${view == 'idosos'}"><header class="page-head"><div><h1>Residentes</h1><p>Consulte os dados e o perfil dos residentes</p></div></header><c:if test="true"><div class="panel form-panel"><h2>Novo residente</h2><form method="post" action="${pageContext.request.contextPath}/app" class="form-grid"><input type="hidden" name="acao" value="idoso"><input type="hidden" name="view" value="idosos"><label>Nome completo *<input required name="nome" maxlength="100"></label><label>Data de nascimento *<input required type="date" name="dataNascimento"></label><label>Quarto<input name="quarto"></label><label>Condições de saúde<input name="condicoes"></label><button class="btn">Cadastrar residente</button></form></div></c:if><div class="panel"><h2>Residentes cadastrados</h2><div class="table-wrap"><table><thead><tr><th>NOME</th><th>NASCIMENTO</th><th>QUARTO</th><th>CONDIÇÕES</th><th>PERFIL</th><c:if test="true"><th>AÇÕES</th></c:if></tr></thead><tbody><c:forEach items="${idosos}" var="i"><tr><td><c:out value="${i.nome}"/></td><td><c:out value="${i.nascimento}"/></td><td><c:out value="${i.quarto}"/></td><td><c:out value="${i.condicoes}"/></td><td><a class="btn small" href="${pageContext.request.contextPath}/app?view=perfil&id=${i.id}">Ver perfil</a></td><c:if test="true"><td><details><summary>Editar</summary><form method="post" action="${pageContext.request.contextPath}/app" class="inline-edit"><input type="hidden" name="acao" value="atualizarIdoso"><input type="hidden" name="view" value="idosos"><input type="hidden" name="id" value="${i.id}"><input required name="nome" value="${i.nome}"><input required type="date" name="dataNascimento" value="${i.nascimento}"><input name="quarto" value="${i.quarto}"><input name="condicoes" value="${i.condicoes}"><button class="btn small">Salvar</button></form><form method="post" action="${pageContext.request.contextPath}/app"><input type="hidden" name="acao" value="arquivar"><input type="hidden" name="view" value="idosos"><input type="hidden" name="entidade" value="idosos"><input type="hidden" name="id" value="${i.id}"><button class="btn danger small">Arquivar</button></form></details></td></c:if></tr></c:forEach></tbody></table></div></div></c:when>
<c:when test="${view == 'medicamentos'}"><header class="page-head"><div><h1>Medicamentos</h1><p>Catálogo de medicamentos e prescrições</p></div></header><div class="panel form-panel"><h2>Novo medicamento</h2><form method="post" action="${pageContext.request.contextPath}/app" class="form-grid"><input type="hidden" name="acao" value="medicamento"><input type="hidden" name="view" value="medicamentos"><label>Nome *<input required name="nome"></label><label>Dosagem<input name="dosagem" placeholder="Ex.: 500 mg"></label><label>Frequência<input name="frequencia" placeholder="Ex.: 1 vez ao dia"></label><button class="btn">Cadastrar medicamento</button></form></div><div class="panel"><h2>Medicamentos cadastrados</h2><div class="table-wrap"><table><thead><tr><th>NOME</th><th>DOSAGEM</th><th>FREQUÊNCIA</th><th>AÇÕES</th></tr></thead><tbody><c:forEach items="${medicamentos}" var="m"><tr><td><c:out value="${m.nome}"/></td><td><c:out value="${m.dosagem}"/></td><td><c:out value="${m.frequencia}"/></td><td><details><summary>Editar</summary><form method="post" action="${pageContext.request.contextPath}/app" class="inline-edit"><input type="hidden" name="acao" value="atualizarMedicamento"><input type="hidden" name="view" value="medicamentos"><input type="hidden" name="id" value="${m.id}"><input required name="nome" value="${m.nome}"><input name="dosagem" value="${m.dosagem}"><input name="frequencia" value="${m.frequencia}"><button class="btn small">Salvar</button></form><form method="post" action="${pageContext.request.contextPath}/app"><input type="hidden" name="acao" value="arquivar"><input type="hidden" name="view" value="medicamentos"><input type="hidden" name="entidade" value="medicamentos"><input type="hidden" name="id" value="${m.id}"><button class="btn danger small">Arquivar</button></form></details></td></tr></c:forEach></tbody></table></div></div></c:when>
<c:when test="${view == 'administracoes'}"><header class="page-head"><div><h1>Administração de medicamentos</h1><p>Registre e consulte o histórico das doses</p></div></header><div class="panel form-panel"><h2>Registrar administração</h2><form method="post" action="${pageContext.request.contextPath}/app" class="form-grid"><input type="hidden" name="acao" value="administracao"><input type="hidden" name="view" value="administracoes"><label>Residente *<select required name="idosoId"><option value="">Selecione</option><c:forEach items="${idosos}" var="i"><option value="${i.id}"><c:out value="${i.nome}"/></option></c:forEach></select></label><label>Medicamento *<select required name="medicamentoId"><option value="">Selecione</option><c:forEach items="${medicamentos}" var="m"><option value="${m.id}"><c:out value="${m.nome}"/> · <c:out value="${m.dosagem}"/></option></c:forEach></select></label><label>Data e hora *<input required type="datetime-local" name="dataHora"></label><label>Responsável *<input required name="responsavel"></label><button class="btn">Registrar dose</button></form></div><div class="panel"><h2>Histórico</h2><div class="table-wrap"><table><thead><tr><th>DATA E HORA</th><th>RESIDENTE</th><th>MEDICAMENTO</th><th>RESPONSÁVEL</th></tr></thead><tbody><c:forEach items="${administracoes}" var="a"><tr><td><c:out value="${a.data}"/></td><td><c:out value="${a.idoso}"/></td><td><c:out value="${a.medicamento}"/> <c:out value="${a.dosagem}"/></td><td><c:out value="${a.responsavel}"/></td></tr></c:forEach></tbody></table></div></div></c:when>
<c:when test="${view == 'agenda'}"><header class="page-head"><div><h1>Agenda de medicamentos</h1><p>Doses do dia organizadas por horário</p></div></header><section class="panel agenda-controls"><div class="agenda-alert-row"><div><h2>Alertas de horário</h2><p class="hint">Mantenha a agenda aberta. O navegador toca um sinal no horário da dose.</p></div><button type="button" class="btn" id="enable-alerts">Ativar alertas sonoros</button></div><form method="get" action="${pageContext.request.contextPath}/app" class="agenda-filter-grid"><input type="hidden" name="view" value="agenda"><label>Data<input type="date" name="data" value="${dataAgenda}"></label><label>Residente<select name="idosoId"><option value="">Todos os residentes</option><c:forEach items="${idosos}" var="i"><option value="${i.id}" ${filtroIdoso == i.id ? 'selected' : ''}><c:out value="${i.nome}"/></option></c:forEach></select></label><label>Turno<select name="turno"><option value="">Todos os turnos</option><option value="MANHA" ${filtroTurno == 'MANHA' ? 'selected' : ''}>Manhã</option><option value="TARDE" ${filtroTurno == 'TARDE' ? 'selected' : ''}>Tarde</option><option value="NOITE" ${filtroTurno == 'NOITE' ? 'selected' : ''}>Noite</option></select></label><label>Status<select name="status"><option value="">Todos os status</option><option value="PENDENTE" ${filtroStatus == 'PENDENTE' ? 'selected' : ''}>Pendente</option><option value="ADMINISTRADA" ${filtroStatus == 'ADMINISTRADA' ? 'selected' : ''}>Administrada</option><option value="ATRASADA" ${filtroStatus == 'ATRASADA' ? 'selected' : ''}>Atrasada</option></select></label><button class="btn agenda-filter-button" type="submit">Filtrar agenda</button></form></section><div id="dose-alerts" class="dose-alerts" aria-live="assertive" aria-atomic="false" hidden></div><div class="panel"><c:choose><c:when test="${empty agenda}"><p class="empty">Nenhuma dose encontrada para esses filtros. Confira se há uma prescrição ativa para o residente e a data selecionados.</p></c:when><c:otherwise><div class="table-wrap"><table class="agenda-table"><thead><tr><th>HORÁRIO</th><th>RESIDENTE</th><th>MEDICAMENTO</th><th>DOSAGEM</th><th>TURNO</th><th>STATUS</th><th>AÇÃO</th></tr></thead><tbody><c:forEach items="${agenda}" var="a"><tr class="dose-row" data-scheduled="${dataAgenda}T${a.hora}:00" data-prescricao-id="${a.prescricaoId}" data-date="${dataAgenda}" data-status="${a.status}"><td><strong><c:out value="${a.hora}"/></strong></td><td><a href="${pageContext.request.contextPath}/app?view=perfil&id=${a.idosoId}"><c:out value="${a.idoso}"/></a></td><td><c:out value="${a.medicamento}"/><c:if test="${not empty a.instrucoes}"><small class="cell-note"><c:out value="${a.instrucoes}"/></small></c:if></td><td><c:out value="${a.dosagem}"/></td><td><c:choose><c:when test="${a.turno == 'MANHA'}">Manhã</c:when><c:when test="${a.turno == 'TARDE'}">Tarde</c:when><c:otherwise>Noite</c:otherwise></c:choose></td><td><span class="dose-status ${a.status == 'ATRASADA' ? 'late' : (a.status == 'ADMINISTRADA' ? 'done' : 'pending')}"><c:choose><c:when test="${a.status == 'ATRASADA'}">Atrasada</c:when><c:when test="${a.status == 'ADMINISTRADA'}">Administrada</c:when><c:otherwise>Pendente</c:otherwise></c:choose></span></td><td><c:choose><c:when test="${a.status == 'ADMINISTRADA'}"><small>Por <c:out value="${a.responsavel}"/></small></c:when><c:otherwise><form method="post" action="${pageContext.request.contextPath}/app"><input type="hidden" name="acao" value="marcarDose"><input type="hidden" name="view" value="agenda"><input type="hidden" name="prescricaoId" value="${a.prescricaoId}"><input type="hidden" name="data" value="${dataAgenda}"><input type="hidden" name="idosoId" value="${filtroIdoso}"><input type="hidden" name="turno" value="${filtroTurno}"><input type="hidden" name="status" value="${filtroStatus}"><button class="btn small">Marcar administrada</button></form></c:otherwise></c:choose></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></div></c:when>
<c:when test="${view == 'perfil'}"><header class="page-head"><div><h1>Perfil do residente</h1><p>Informações e medicamentos prescritos</p></div><a class="btn" href="${pageContext.request.contextPath}/app?view=agenda&idosoId=${idoso.id}">Ver agenda</a></header><div class="panel profile-grid"><div><small>NOME COMPLETO</small><b><c:out value="${idoso.nome}"/></b></div><div><small>NASCIMENTO</small><b><c:out value="${idoso.nascimento}"/></b></div><div><small>QUARTO</small><b><c:out value="${idoso.quarto}"/></b></div><div><small>CONDIÇÕES DE SAÚDE</small><b><c:out value="${idoso.condicoes}"/></b></div></div><div class="panel"><h2>Prescrições ativas</h2><c:choose><c:when test="${empty prescricoesIdoso}"><p class="empty">Ainda não há prescrições ativas para este residente.</p></c:when><c:otherwise><div class="table-wrap"><table><thead><tr><th>MEDICAMENTO</th><th>DOSAGEM</th><th>HORÁRIO</th><th>INÍCIO</th><th>FIM</th><th>INSTRUÇÕES</th></tr></thead><tbody><c:forEach items="${prescricoesIdoso}" var="p"><tr><td><c:out value="${p.medicamento}"/></td><td><c:out value="${p.dosagem}"/></td><td><c:out value="${p.horario}"/></td><td><c:out value="${p.inicio}"/></td><td><c:out value="${p.fim}"/></td><td><c:out value="${p.instrucoes}"/></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></div></c:when>
<c:when test="${view == 'prescricoes'}"><header class="page-head"><div><h1>Prescrições</h1><p>Vincule medicamento, residente, dosagem e horário diário</p></div></header><div class="panel form-panel"><h2>Nova prescrição</h2><p class="hint">Cada horário é cadastrado separadamente. Para um medicamento em mais de um horário, crie uma prescrição para cada horário.</p><form method="post" action="${pageContext.request.contextPath}/app" class="form-grid"><input type="hidden" name="acao" value="prescricao"><input type="hidden" name="view" value="prescricoes"><label>Residente *<select required name="idosoId"><option value="">Selecione</option><c:forEach items="${idosos}" var="i"><option value="${i.id}"><c:out value="${i.nome}"/></option></c:forEach></select></label><label>Medicamento *<select required name="medicamentoId"><option value="">Selecione</option><c:forEach items="${medicamentos}" var="m"><option value="${m.id}"><c:out value="${m.nome}"/> · <c:out value="${m.dosagem}"/></option></c:forEach></select></label><label>Dosagem prescrita *<input required name="dosagem" maxlength="80" placeholder="Ex.: 500 mg"></label><label>Horário diário *<input required type="time" name="horario"></label><label>Data de início *<input required type="date" name="dataInicio" value="${hoje}"></label><label>Data final<input type="date" name="dataFim"></label><label>Instruções<input name="instrucoes" maxlength="255" placeholder="Ex.: após o almoço"></label><button class="btn">Salvar prescrição</button></form></div><div class="panel"><h2>Prescrições ativas</h2><div class="table-wrap"><table><thead><tr><th>RESIDENTE</th><th>MEDICAMENTO</th><th>DOSAGEM</th><th>HORÁRIO</th><th>INÍCIO</th><th>FIM</th><th>AÇÃO</th></tr></thead><tbody><c:forEach items="${prescricoes}" var="p"><tr><td><c:out value="${p.idoso}"/></td><td><c:out value="${p.medicamento}"/></td><td><c:out value="${p.dosagem}"/></td><td><c:out value="${p.horario}"/></td><td><c:out value="${p.inicio}"/></td><td><c:out value="${p.fim}"/></td><td><form method="post" action="${pageContext.request.contextPath}/app"><input type="hidden" name="acao" value="arquivarPrescricao"><input type="hidden" name="view" value="prescricoes"><input type="hidden" name="id" value="${p.id}"><button class="btn danger small">Encerrar</button></form></td></tr></c:forEach></tbody></table></div></div></c:when>
<c:when test="${view == 'usuarios'}"><header class="page-head"><div><h1>Usuários</h1><p>Cadastre cuidadores e administradores com confirmação de e-mail</p></div></header><div class="panel form-panel"><h2>Nova conta da equipe</h2><form method="post" action="${pageContext.request.contextPath}/auth" class="form-grid"><input type="hidden" name="acao" value="criarUsuario"><label>Perfil *<select required name="perfil"><option value="CUIDADOR">Cuidador</option><option value="ADMIN">Administrador</option></select></label><label>Nome completo *<input required name="nome" maxlength="100"></label><label>Telefone com DDD *<input required name="telefone" type="tel" placeholder="(11) 99999-9999"></label><label>E-mail *<input required name="email" type="email" maxlength="254"></label><label>Senha inicial *<input required name="senha" type="password" minlength="8"><small>A pessoa poderá entrar após confirmar o e-mail.</small></label><button class="btn">Criar conta e enviar confirmação</button></form></div><div class="panel"><h2>Contas cadastradas</h2><div class="table-wrap"><table><thead><tr><th>NOME</th><th>PERFIL</th><th>E-MAIL</th><th>TELEFONE</th><th>STATUS</th></tr></thead><tbody><c:forEach items="${usuarios}" var="u"><tr><td><c:out value="${u.nome}"/></td><td><c:choose><c:when test="${u.perfil == 'ADMIN'}">Administrador</c:when><c:otherwise>Cuidador</c:otherwise></c:choose></td><td><c:out value="${u.email}"/></td><td><c:out value="${u.telefone}"/></td><td><c:choose><c:when test="${u.ativo}">Ativo</c:when><c:otherwise>Inativo</c:otherwise></c:choose></td></tr></c:forEach></tbody></table></div></div></c:when>
</c:choose>
<script>
(()=>{const rows=[...document.querySelectorAll('.dose-row')],button=document.getElementById('enable-alerts'),alertArea=document.getElementById('dose-alerts');if(!button)return;let enabled=false,ctx=null;
function beep(){if(!ctx)return;const o=ctx.createOscillator(),g=ctx.createGain();o.type='sine';o.frequency.value=880;g.gain.value=.12;o.connect(g);g.connect(ctx.destination);o.start();o.stop(ctx.currentTime+.28);}
function showDoseCard(row){if(!alertArea)return;alertArea.hidden=false;const cells=row.querySelectorAll('td');const card=document.createElement('article');card.className='dose-alert-card';card.setAttribute('role','alert');const mark=document.createElement('span');mark.className='dose-alert-mark';mark.textContent='!';const body=document.createElement('div');body.className='dose-alert-body';const title=document.createElement('h2');title.textContent='Hora de administrar medicamento';const note=document.createElement('p');note.className='dose-alert-note';note.textContent='Confira a prescrição e registre a dose após administrá-la.';const details=document.createElement('dl');details.className='dose-alert-details';const vals=[['Residente',cells[1]?.innerText.trim()||'—'],['Medicamento',cells[2]?.innerText.trim()||'—'],['Dosagem',cells[3]?.innerText.trim()||'—'],['Horário',(cells[0]?.innerText.trim()||'—')+' · '+row.dataset.date.split('-').reverse().join('/')]];for(const [label,value] of vals){const item=document.createElement('div');const term=document.createElement('dt');term.textContent=label;const description=document.createElement('dd');description.textContent=value;item.append(term,description);details.append(item);}body.append(title,details,note);const close=document.createElement('button');close.type='button';close.className='dose-alert-close';close.textContent='Entendi';close.addEventListener('click',()=>{card.remove();if(!alertArea.children.length)alertArea.hidden=true;});card.append(mark,body,close);alertArea.append(card);}
function update(){const now=new Date();for(const row of rows){if(row.dataset.status==='ADMINISTRADA')continue;const scheduled=new Date(row.dataset.scheduled);if(now>=scheduled){row.classList.add('dose-late');row.dataset.status='ATRASADA';const badge=row.querySelector('.dose-status');if(badge){badge.textContent='Atrasada';badge.className='dose-status late';}if(enabled){const key='caredrop-alert-'+row.dataset.prescricaoId+'-'+row.dataset.date;if(!sessionStorage.getItem(key)){beep();showDoseCard(row);sessionStorage.setItem(key,'1');}}}}}
button.addEventListener('click',async()=>{const Audio=window.AudioContext||window.webkitAudioContext;if(!Audio){button.textContent='Áudio indisponível neste navegador';return;}try{ctx=ctx||new Audio();await ctx.resume();enabled=true;button.textContent='Alertas sonoros ativados';beep();setTimeout(beep,350);update();}catch(e){button.textContent='Permita o áudio no navegador e tente novamente';}});update();setInterval(update,15000);})();
</script>
<footer>Care Drop · Sistema Integrado de Gestão · Dados armazenados no MySQL</footer></div></main></body></html>






