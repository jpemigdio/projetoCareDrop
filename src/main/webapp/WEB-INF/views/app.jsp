<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="pt-BR"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Care Drop</title><link rel="icon" type="image/jpeg" href="${pageContext.request.contextPath}/assets/logo.jpg">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css">
</head><body><div class="topbar"><span class="brand-mini">M</span><strong>Care Drop</strong><span class="top-title">Sistema de gestão de medicamentos e doação de sangue</span><span class="top-user">CM&nbsp; Carla Mendes</span></div>
<aside class="sidebar"><div class="brand"><span class="brand-mark">M</span><div><b>Care Drop</b><small>Casa de Repouso</small></div></div><nav>
<a class="${view == 'dashboard' ? 'active' : ''}" href="${pageContext.request.contextPath}/app?view=dashboard"><i>▦</i>Dashboard</a>
<div class="nav-label">MEDICAMENTOS</div><a class="${view == 'idosos' ? 'active' : ''}" href="${pageContext.request.contextPath}/app?view=idosos"><i>♙</i>Residentes</a><a class="${view == 'medicamentos' ? 'active' : ''}" href="${pageContext.request.contextPath}/app?view=medicamentos"><i>✚</i>Medicamentos</a><a class="${view == 'administracoes' ? 'active' : ''}" href="${pageContext.request.contextPath}/app?view=administracoes"><i>◷</i>Histórico de doses</a>
<div class="nav-label">DOAÇÃO DE SANGUE</div><a class="${view == 'doadores' ? 'active' : ''}" href="${pageContext.request.contextPath}/app?view=doadores"><i>♧</i>Doadores</a><a class="${view == 'doacoes' ? 'active' : ''}" href="${pageContext.request.contextPath}/app?view=doacoes"><i>♥</i>Doações</a><a class="${view == 'estoque' ? 'active' : ''}" href="${pageContext.request.contextPath}/app?view=estoque"><i>▤</i>Estoque e consumo</a><a class="${view == 'previsao' ? 'active' : ''}" href="${pageContext.request.contextPath}/app?view=previsao"><i>⌁</i>Previsão</a></nav><div class="sidebar-bottom"><div class="avatar">CM</div><div><b>Carla Mendes</b><small>Enfermeira chefe</small></div></div></aside>
<main class="main"><div class="content"><c:if test="${not empty erro}"><div class="notice error">⚠ &nbsp;<c:out value="${erro}"/></div></c:if><c:if test="${not empty sucesso}"><div class="notice success">✓ &nbsp;<c:out value="${sucesso}"/></div></c:if>
<c:choose>
<c:when test="${view == 'dashboard'}"><header class="page-head"><div><h1>Visão Geral</h1><p>Um resumo do cuidado e dos estoques</p></div><span class="today">Painel integrado</span></header>
<div class="stats"><article class="stat"><span>RESIDENTES</span><b>${idososTotal}</b><em>♙</em></article><article class="stat"><span>MEDICAMENTOS</span><b>${medicamentosTotal}</b><em>✚</em></article><article class="stat"><span>DOAÇÕES REGISTRADAS</span><b>${doacoesTotal}</b><em class="red">♥</em></article><article class="stat"><span>BOLSAS EM ESTOQUE</span><b><c:set var="soma" value="0"/><c:forEach items="${estoque}" var="e"><c:set var="soma" value="${soma + e.quantidade}"/></c:forEach>${soma}</b><em>▤</em></article></div>
<c:set var="estoqueBaixo" value="false"/><c:forEach items="${estoque}" var="e"><c:if test="${e.quantidade < 20}"><c:set var="estoqueBaixo" value="true"/></c:if></c:forEach><c:if test="${estoqueBaixo}"><div class="notice error">⚠ &nbsp; Atenção: existem tipos sanguíneos com menos de 20 bolsas. <a href="${pageContext.request.contextPath}/app?view=estoque">Ver estoque</a></div></c:if><div class="section-title"><h2>Estoque de sangue</h2><a href="${pageContext.request.contextPath}/app?view=estoque">Ver detalhes →</a></div><div class="blood-grid"><c:forEach items="${estoque}" var="e"><div class="blood-card"><span class="blood-type"><c:out value="${e.tipo}"/></span><b><c:out value="${e.quantidade}"/></b><small>bolsas disponíveis</small><div class="bar"><span style="width:${e.quantidade > 100 ? 100 : e.quantidade}%"></span></div></div></c:forEach></div>
<div class="two-col"><section class="panel"><div class="section-title"><h2>Doações recentes</h2><a href="${pageContext.request.contextPath}/app?view=doacoes">Ver histórico →</a></div><c:choose><c:when test="${empty doacoes}"><p class="empty">Ainda não há doações registradas.</p></c:when><c:otherwise><div class="table-wrap"><table><thead><tr><th>DOADOR</th><th>TIPO</th><th>BOLSAS</th><th>DATA</th></tr></thead><tbody><c:forEach items="${doacoes}" var="d"><tr><td><c:out value="${d.doador}"/></td><td><span class="tag blood"><c:out value="${d.tipo}"/></span></td><td><c:out value="${d.bolsas}"/></td><td><c:out value="${d.data}"/></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></section>
<section class="panel"><div class="section-title"><h2>Doses administradas</h2><a href="${pageContext.request.contextPath}/app?view=administracoes">Ver histórico →</a></div><c:choose><c:when test="${empty administracoes}"><p class="empty">Ainda não há administrações registradas.</p></c:when><c:otherwise><div class="table-wrap"><table><thead><tr><th>RESIDENTE</th><th>MEDICAMENTO</th><th>RESPONSÁVEL</th></tr></thead><tbody><c:forEach items="${administracoes}" var="a"><tr><td><c:out value="${a.idoso}"/></td><td><c:out value="${a.medicamento}"/> <small><c:out value="${a.dosagem}"/></small></td><td><c:out value="${a.responsavel}"/></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></section></div>
</c:when>
<c:when test="${view == 'idosos'}"><header class="page-head"><div><h1>Residentes</h1><p>Cadastro e acompanhamento dos residentes</p></div></header><div class="panel form-panel"><h2>Novo residente</h2><form method="post" action="${pageContext.request.contextPath}/app" class="form-grid"><input type="hidden" name="acao" value="idoso"><input type="hidden" name="view" value="idosos"><label>Nome completo *<input required name="nome" maxlength="100"></label><label>Data de nascimento *<input required type="date" name="dataNascimento"></label><label>Quarto<input name="quarto" placeholder="Ex.: 102 · Ala Norte"></label><label>Condições de saúde<input name="condicoes" placeholder="Separe por vírgula"></label><button class="btn">Cadastrar residente</button></form></div><div class="panel"><h2>Residentes cadastrados</h2><div class="table-wrap"><table><thead><tr><th>NOME</th><th>NASCIMENTO</th><th>QUARTO</th><th>CONDIÇÕES</th><th>AÇÕES</th></tr></thead><tbody><c:forEach items="${idosos}" var="i"><tr><td><c:out value="${i.nome}"/></td><td><c:out value="${i.nascimento}"/></td><td><c:out value="${i.quarto}"/></td><td><c:out value="${i.condicoes}"/></td><td><details><summary>Editar</summary><form method="post" action="${pageContext.request.contextPath}/app" class="inline-edit"><input type="hidden" name="acao" value="atualizarIdoso"><input type="hidden" name="view" value="idosos"><input type="hidden" name="id" value="${i.id}"><input required name="nome" value="${i.nome}"><input required type="date" name="dataNascimento" value="${i.nascimento}"><input name="quarto" value="${i.quarto}"><input name="condicoes" value="${i.condicoes}"><button class="btn small">Salvar</button></form><form method="post" action="${pageContext.request.contextPath}/app"><input type="hidden" name="acao" value="arquivar"><input type="hidden" name="view" value="idosos"><input type="hidden" name="entidade" value="idosos"><input type="hidden" name="id" value="${i.id}"><button class="btn danger small">Arquivar</button></form></details></td></tr></c:forEach></tbody></table></div></div></c:when>
<c:when test="${view == 'medicamentos'}"><header class="page-head"><div><h1>Medicamentos</h1><p>Catálogo de medicamentos e prescrições</p></div></header><div class="panel form-panel"><h2>Novo medicamento</h2><form method="post" action="${pageContext.request.contextPath}/app" class="form-grid"><input type="hidden" name="acao" value="medicamento"><input type="hidden" name="view" value="medicamentos"><label>Nome *<input required name="nome"></label><label>Dosagem<input name="dosagem" placeholder="Ex.: 500 mg"></label><label>Frequência<input name="frequencia" placeholder="Ex.: 1 vez ao dia"></label><button class="btn">Cadastrar medicamento</button></form></div><div class="panel"><h2>Medicamentos cadastrados</h2><div class="table-wrap"><table><thead><tr><th>NOME</th><th>DOSAGEM</th><th>FREQUÊNCIA</th><th>AÇÕES</th></tr></thead><tbody><c:forEach items="${medicamentos}" var="m"><tr><td><c:out value="${m.nome}"/></td><td><c:out value="${m.dosagem}"/></td><td><c:out value="${m.frequencia}"/></td><td><details><summary>Editar</summary><form method="post" action="${pageContext.request.contextPath}/app" class="inline-edit"><input type="hidden" name="acao" value="atualizarMedicamento"><input type="hidden" name="view" value="medicamentos"><input type="hidden" name="id" value="${m.id}"><input required name="nome" value="${m.nome}"><input name="dosagem" value="${m.dosagem}"><input name="frequencia" value="${m.frequencia}"><button class="btn small">Salvar</button></form><form method="post" action="${pageContext.request.contextPath}/app"><input type="hidden" name="acao" value="arquivar"><input type="hidden" name="view" value="medicamentos"><input type="hidden" name="entidade" value="medicamentos"><input type="hidden" name="id" value="${m.id}"><button class="btn danger small">Arquivar</button></form></details></td></tr></c:forEach></tbody></table></div></div></c:when>
<c:when test="${view == 'administracoes'}"><header class="page-head"><div><h1>Administração de medicamentos</h1><p>Registre e consulte o histórico das doses</p></div></header><div class="panel form-panel"><h2>Registrar administração</h2><form method="post" action="${pageContext.request.contextPath}/app" class="form-grid"><input type="hidden" name="acao" value="administracao"><input type="hidden" name="view" value="administracoes"><label>Residente *<select required name="idosoId"><option value="">Selecione</option><c:forEach items="${idosos}" var="i"><option value="${i.id}"><c:out value="${i.nome}"/></option></c:forEach></select></label><label>Medicamento *<select required name="medicamentoId"><option value="">Selecione</option><c:forEach items="${medicamentos}" var="m"><option value="${m.id}"><c:out value="${m.nome}"/> · <c:out value="${m.dosagem}"/></option></c:forEach></select></label><label>Data e hora *<input required type="datetime-local" name="dataHora"></label><label>Responsável *<input required name="responsavel"></label><button class="btn">Registrar dose</button></form></div><div class="panel"><h2>Histórico</h2><div class="table-wrap"><table><thead><tr><th>DATA E HORA</th><th>RESIDENTE</th><th>MEDICAMENTO</th><th>RESPONSÁVEL</th></tr></thead><tbody><c:forEach items="${administracoes}" var="a"><tr><td><c:out value="${a.data}"/></td><td><c:out value="${a.idoso}"/></td><td><c:out value="${a.medicamento}"/> <c:out value="${a.dosagem}"/></td><td><c:out value="${a.responsavel}"/></td></tr></c:forEach></tbody></table></div></div></c:when>
<c:when test="${view == 'doadores'}"><header class="page-head"><div><h1>Doadores</h1><p>Cadastre doadores e consulte os tipos sanguíneos</p></div></header><div class="panel form-panel"><h2>Novo doador</h2><form method="post" action="${pageContext.request.contextPath}/app" class="form-grid"><input type="hidden" name="acao" value="doador"><input type="hidden" name="view" value="doadores"><label>Nome completo *<input required name="nome"></label><label>CPF *<input required name="cpf" maxlength="14" placeholder="000.000.000-00"></label><label>Tipo sanguíneo *<select required name="tipo"><option value="">Selecione</option><c:forEach items="${tipos}" var="t"><option><c:out value="${t}"/></option></c:forEach></select></label><label>Telefone<input name="telefone"></label><button class="btn">Cadastrar doador</button></form></div><div class="panel"><h2>Doadores cadastrados</h2><div class="table-wrap"><table><thead><tr><th>NOME</th><th>CPF</th><th>TIPO</th><th>TELEFONE</th><th>AÇÕES</th></tr></thead><tbody><c:forEach items="${doadores}" var="d"><tr><td><c:out value="${d.nome}"/></td><td><c:out value="${d.cpf}"/></td><td><span class="tag blood"><c:out value="${d.tipo}"/></span></td><td><c:out value="${d.telefone}"/></td><td><details><summary>Editar</summary><form method="post" action="${pageContext.request.contextPath}/app" class="inline-edit"><input type="hidden" name="acao" value="atualizarDoador"><input type="hidden" name="view" value="doadores"><input type="hidden" name="id" value="${d.id}"><input required name="nome" value="${d.nome}"><input required name="cpf" value="${d.cpf}"><select required name="tipo"><c:forEach items="${tipos}" var="t"><option<c:if test="${t == d.tipo}"> selected</c:if>><c:out value="${t}"/></option></c:forEach></select><input name="telefone" value="${d.telefone}"><button class="btn small">Salvar</button></form><form method="post" action="${pageContext.request.contextPath}/app"><input type="hidden" name="acao" value="arquivar"><input type="hidden" name="view" value="doadores"><input type="hidden" name="entidade" value="doadores"><input type="hidden" name="id" value="${d.id}"><button class="btn danger small">Arquivar</button></form></details></td></tr></c:forEach></tbody></table></div></div></c:when>
<c:when test="${view == 'doacoes'}"><header class="page-head"><div><h1>Doações</h1><p>Registre coletas e veja as doações realizadas</p></div></header><div class="panel form-panel"><h2>Registrar doação</h2><form method="post" action="${pageContext.request.contextPath}/app" class="form-grid"><input type="hidden" name="acao" value="doacao"><input type="hidden" name="view" value="doacoes"><label>Doador *<select required name="doadorId"><option value="">Selecione</option><c:forEach items="${doadores}" var="d"><option value="${d.id}"><c:out value="${d.nome}"/> · <c:out value="${d.tipo}"/></option></c:forEach></select></label><label>Tipo sanguíneo *<select required name="tipo"><option value="">Selecione</option><c:forEach items="${tipos}" var="t"><option><c:out value="${t}"/></option></c:forEach></select></label><label>Quantidade de bolsas *<input required type="number" min="1" name="bolsas"></label><label>Data da doação *<input required type="date" name="data"></label><button class="btn">Salvar doação e atualizar estoque</button></form><p class="hint">A doação e a entrada no estoque são salvas juntas.</p></div><div class="panel"><h2>Histórico de doações</h2><div class="table-wrap"><table><thead><tr><th>DATA</th><th>DOADOR</th><th>TIPO</th><th>BOLSAS</th></tr></thead><tbody><c:forEach items="${doacoes}" var="d"><tr><td><c:out value="${d.data}"/></td><td><c:out value="${d.doador}"/></td><td><span class="tag blood"><c:out value="${d.tipo}"/></span></td><td><c:out value="${d.bolsas}"/></td></tr></c:forEach></tbody></table></div></div></c:when>
<c:when test="${view == 'estoque'}"><header class="page-head"><div><h1>Estoque de sangue</h1><p>Disponibilidade atual e registro de consumo</p></div></header><div class="blood-grid stock-grid"><c:forEach items="${estoque}" var="e"><div class="blood-card"><span class="blood-type"><c:out value="${e.tipo}"/></span><b><c:out value="${e.quantidade}"/></b><small>bolsas disponíveis</small><c:choose><c:when test="${e.quantidade < 20}"><em class="status low">Estoque baixo</em></c:when><c:otherwise><em class="status good">Disponível</em></c:otherwise></c:choose><small>Atualizado: <c:out value="${e.atualizado}"/></small></div></c:forEach></div><div class="panel form-panel"><h2>Registrar consumo</h2><form method="post" action="${pageContext.request.contextPath}/app" class="form-grid"><input type="hidden" name="acao" value="consumo"><input type="hidden" name="view" value="estoque"><label>Tipo sanguíneo *<select required name="tipo"><option value="">Selecione</option><c:forEach items="${tipos}" var="t"><option><c:out value="${t}"/></option></c:forEach></select></label><label>Bolsas consumidas *<input required type="number" min="1" name="bolsas"></label><label>Data *<input required type="date" name="data"></label><label>Motivo<input name="motivo"></label><button class="btn">Registrar consumo</button></form><p class="hint">O sistema não permite baixar mais bolsas do que há disponíveis.</p></div><div class="panel"><h2>Histórico de consumo</h2><div class="table-wrap"><table><thead><tr><th>DATA</th><th>TIPO</th><th>BOLSAS</th><th>MOTIVO</th></tr></thead><tbody><c:forEach items="${consumos}" var="c"><tr><td><c:out value="${c.data}"/></td><td><span class="tag blood"><c:out value="${c.tipo}"/></span></td><td><c:out value="${c.bolsas}"/></td><td><c:out value="${c.motivo}"/></td></tr></c:forEach></tbody></table></div></div></c:when>
<c:when test="${view == 'previsao'}"><header class="page-head"><div><h1>Previsão de demanda</h1><p>Estimativa baseada no histórico recente de consumo</p></div></header><div class="forecast"><span>MÉDIA MENSAL DOS PERÍODOS REGISTRADOS</span><strong>${media}</strong><small>bolsas por mês · estimativa simples</small></div><div class="panel"><h2>Consumo por mês · últimos 6 meses</h2><c:choose><c:when test="${empty historico}"><p class="empty">Registre consumos para formar o histórico e calcular uma média.</p></c:when><c:otherwise><div class="table-wrap"><table><thead><tr><th>PERÍODO</th><th>BOLSAS CONSUMIDAS</th></tr></thead><tbody><c:forEach items="${historico}" var="h"><tr><td><c:out value="${h.periodo}"/></td><td><c:out value="${h.bolsas}"/></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose><p class="hint">A previsão é uma aproximação histórica para apoiar o planejamento; não garante a demanda futura.</p></div></c:when>
</c:choose>
<footer>Care Drop · Sistema Integrado de Gestão · Dados armazenados no MySQL</footer></div></main></body></html>




